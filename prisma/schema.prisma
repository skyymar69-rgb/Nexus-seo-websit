generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  image         String?
  company       String?
  role          String    @default("user")
  plan          String    @default("free")
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  websites      Website[]
  keywords      Keyword[]
  reports       Report[]
  notifications Notification[]
  subscription  Subscription?
  auditCredits  Int            @default(5)
  apiKey        String?        @unique

  @@index([email])
  @@index([plan])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== PROJECTS ====================

model Website {
  id        String   @id @default(cuid())
  domain    String
  name      String?
  userId    String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  audits            Audit[]
  crawlSessions     CrawlSession[]
  keywordTracking   KeywordTracking[]
  backlinks         Backlink[]
  aiQueries         AIVisibilityQuery[]
  contentPages      ContentPage[]
  performanceData   PerformanceData[]
  scanSessions      ScanSession[]
  rankTrackers      RankTrackerConfig[]
  backlinkSnapshots BacklinkSnapshot[]

  @@unique([domain, userId])
  @@index([userId])
  @@index([domain])
}

// ==================== AUDIT ====================

model Audit {
  id            String   @id @default(cuid())
  websiteId     String
  url           String
  score         Int
  grade         String
  status        String   @default("completed")
  metaData      String?
  contentData   String?
  technicalData String?
  categories    String?
  checks        String?
  createdAt     DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([createdAt])
}

// ==================== CRAWL ====================

model CrawlSession {
  id           String    @id @default(cuid())
  websiteId    String
  status       String    @default("running")
  pagesFound   Int       @default(0)
  pagesCrawled Int       @default(0)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  config       String?
  // Portage OpenSEO (lot crawl) : URL de départ résolue, erreur de fin, et
  // nombre d'URL découvertes via sitemap.
  startUrl     String?
  error        String?
  sitemapUrls  Int       @default(0)

  website     Website       @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  pages       CrawledPage[]
  crawlIssues CrawlIssue[]

  @@index([websiteId])
}

model CrawledPage {
  id                 String   @id @default(cuid())
  crawlSessionId     String
  url                String
  statusCode         Int
  contentType        String?
  contentLength      Int      @default(0)
  responseTime       Int      @default(0)
  title              String?
  metaDescription    String?
  h1Count            Int      @default(0)
  h2Count            Int      @default(0)
  internalLinks      Int      @default(0)
  externalLinks      Int      @default(0)
  images             Int      @default(0)
  imagesNoAlt        Int      @default(0)
  issues             String?
  crawledAt          DateTime @default(now())
  // Portage OpenSEO : signaux d'indexabilité et de structure par page.
  fetchClass         String   @default("ok") // ok | blocked | error
  redirectUrl        String?
  canonicalUrl       String?
  headerCanonicalUrl String?
  robotsMeta         String?
  xRobotsTag         String?
  isIndexable        Boolean  @default(true)
  wordCount          Int      @default(0)
  contentHash        String?
  headingOrder       String? // JSON: [1,2,2,3]
  crawlDepth         Int?
  inSitemap          Boolean  @default(false)
  hasStructuredData  Boolean  @default(false)

  crawlSession CrawlSession @relation(fields: [crawlSessionId], references: [id], onDelete: Cascade)
  crawlIssues  CrawlIssue[]

  @@index([crawlSessionId])
  @@index([url])
}

// Constats d'audit multipage (portage OpenSEO). Un constat par (session, type,
// page, clé de dédoublonnage) ; le catalogue des types vit dans lib/audit/issues.ts.
model CrawlIssue {
  id             String   @id @default(cuid())
  crawlSessionId String
  pageId         String?
  pageUrl        String
  issueType      String
  severity       String // critical | warning | info
  details        String? // JSON
  dedupeKey      String   @default("")
  createdAt      DateTime @default(now())

  crawlSession CrawlSession @relation(fields: [crawlSessionId], references: [id], onDelete: Cascade)
  page         CrawledPage? @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([crawlSessionId, issueType, pageUrl, dedupeKey])
  @@index([crawlSessionId, severity])
  @@index([issueType])
}

// ==================== KEYWORDS ====================

model Keyword {
  id         String   @id @default(cuid())
  term       String
  volume     Int?
  difficulty Int?
  cpc        Float?
  intent     String?
  language   String   @default("fr")
  userId     String
  createdAt  DateTime @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracking KeywordTracking[]

  @@unique([term, userId, language])
  @@index([userId])
  @@index([term])
}

model KeywordTracking {
  id               String   @id @default(cuid())
  keywordId        String
  websiteId        String
  position         Int?
  previousPosition Int?
  url              String?
  serpFeatures     String?
  date             DateTime @default(now())
  // Portage OpenSEO : provenance de l'instantané (run, appareil, localisation).
  runId            String?
  device           String   @default("desktop")
  locationName     String   @default("")

  keyword Keyword       @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  website Website       @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  run     RankCheckRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([keywordId, websiteId, date])
  @@index([keywordId])
  @@index([websiteId])
  @@index([date])
  @@index([runId])
}

// ==================== RANK TRACKING (portage OpenSEO) ====================

// Configuration de suivi par site : marché (pays, langue), localisation locale
// optionnelle (chaîne canonique DataForSEO, ex. "Lyon,Auvergne-Rhone-Alpes,France"),
// appareil et profondeur SERP. locationName vide = suivi national.
model RankTrackerConfig {
  id           String   @id @default(cuid())
  websiteId    String
  locationCode Int      @default(2250)
  locationName String   @default("")
  languageCode String   @default("fr")
  device       String   @default("desktop") // desktop | mobile
  depth        Int      @default(20)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  website Website        @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  runs    RankCheckRun[]

  @@unique([websiteId, locationName, device])
  @@index([websiteId])
  @@index([active])
}

model RankCheckRun {
  id              String    @id @default(cuid())
  configId        String
  status          String    @default("running") // running | completed | failed
  trigger         String    @default("manual") // manual | cron | mcp
  keywordsTotal   Int       @default(0)
  keywordsChecked Int       @default(0)
  costMicros      Int       @default(0) // micro-dollars réellement facturés par DataForSEO
  error           String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  config    RankTrackerConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  snapshots KeywordTracking[]

  @@index([configId, startedAt])
  @@index([status])
}

// ==================== BACKLINKS ====================

model Backlink {
  id           String   @id @default(cuid())
  websiteId    String
  sourceUrl    String
  sourceDomain String
  targetUrl    String
  anchorText   String?
  da           Int?
  dr           Int?
  linkType     String   @default("dofollow")
  status       String   @default("active")
  spamScore    Int?
  firstSeen    DateTime @default(now())
  lastChecked  DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, sourceUrl, targetUrl])
  @@index([websiteId])
  @@index([sourceDomain])
  @@index([status])
}

// Instantané daté du profil de liens (portage OpenSEO) : ce que DataForSEO
// renvoie au moment du rafraîchissement, pour tracer l'évolution.
model BacklinkSnapshot {
  id                   String   @id @default(cuid())
  websiteId            String
  backlinks            Int      @default(0)
  referringDomains     Int      @default(0)
  referringPages       Int?
  rank                 Int?
  newBacklinks         Int?
  lostBacklinks        Int?
  newReferringDomains  Int?
  lostReferringDomains Int?
  spamScore            Int?
  createdAt            DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, createdAt])
}

// ==================== FOURNISSEURS DE DONNEES (portage OpenSEO) ====================

// Journal append-only des appels payants à un fournisseur externe (DataForSEO).
// Une ligne par appel, coût réel renvoyé par le fournisseur en micro-dollars
// (1 $ = 1 000 000). Le solde mensuel est une somme ; aucune ligne n'est mise à jour.
model DataProviderUsage {
  id         String   @id @default(cuid())
  provider   String   @default("dataforseo")
  userId     String?
  websiteId  String?
  feature    String // keyword_research | rank_tracking | backlinks | serp | local_seo | domain | mcp
  path       String // chemin DataForSEO, ex. v3/serp/google/organic/live/advanced
  costMicros Int      @default(0)
  status     String   @default("ok") // ok | failed
  createdAt  DateTime @default(now())

  @@index([provider, createdAt])
  @@index([userId, createdAt])
  @@index([websiteId, createdAt])
}

// ==================== AI VISIBILITY ====================

model AIVisibilityQuery {
  id          String   @id @default(cuid())
  websiteId   String
  prompt      String
  llm         String
  mentioned   Boolean  @default(false)
  position    Int?
  context     String?
  sentiment   String?
  competitors String?
  sources     String?
  response    String?
  date        DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([llm])
  @@index([date])
}

// ==================== CONTENT ====================

model ContentPage {
  id             String   @id @default(cuid())
  websiteId      String
  url            String
  title          String?
  score          Int?
  wordCount      Int?
  readability    Float?
  keywordDensity Float?
  targetKeyword  String?
  suggestions    String?
  content        String?
  lastAnalyzed   DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, url])
  @@index([websiteId])
}

// ==================== PERFORMANCE ====================

model PerformanceData {
  id            String   @id @default(cuid())
  websiteId     String
  url           String
  score         Int
  grade         String
  lcp           Float?
  fid           Float?
  cls           Float?
  ttfb          Float?
  fcp           Float?
  tti           Float?
  tbt           Float?
  speedIndex    Float?
  pageSize      Int?
  requests      Int?
  resources     String?
  opportunities String?
  device        String   @default("desktop")
  testedAt      DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([testedAt])
}

// ==================== REPORTS ====================

model Report {
  id        String   @id @default(cuid())
  userId    String
  title     String
  type      String
  format    String   @default("json")
  data      String?
  status    String   @default("completed")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  data      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

// ==================== SCAN ====================

model ScanSession {
  id          String    @id @default(cuid())
  websiteId   String
  url         String
  status      String    @default("pending") // pending | running | completed | failed
  progress    Int       @default(0)
  totalSteps  Int       @default(6)
  currentStep String? // nom de l'etape en cours
  results     String? // JSON — AEO, GEO, GEO engine scores
  auditScore  Int?
  auditGrade  String?
  aeoScore    Int?
  geoScore    Int?
  perfScore   Int?
  crawlPages  Int?
  error       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([status])
  @@index([startedAt])
}

// ==================== SUBSCRIPTION ====================

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  plan                 String    @default("free")
  status               String    @default("active")
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
